    "react-dom": "^18.2.0",
    "react-router-dom": "^7.15.0",
    "styled-components": "^6.1.8",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
